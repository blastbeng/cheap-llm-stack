.aider*

.env

# board-local artefacts: the llama.cpp clone, the out-of-tree build, the
# installed binaries and the ~10 GB of GGUF models never belong in the repo
/llama.cpp/
/.llama-build/
/bin/
/models/
/.llama-cpp-version
# rolling copy of the last build that passed the tool-calling check, kept by
# update-llama.cpp.sh so a regression can be rolled back without a 40 min rebuild
/.build-backup/
*.log

# python bytecode
__pycache__/
*.pyc
