[Unit]
Description=cheap-llm-stack llama-swap orchestrator (Orange Pi Zero 3W)
Documentation=https://github.com/mostlygeek/llama-swap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cheap-llm-stack
Environment=LLAMA_SWAP_CONFIG=/opt/cheap-llm-stack/config.yaml
ExecStart=/opt/cheap-llm-stack/bin/llama-swap --host 0.0.0.0 --port 10001 --config /opt/cheap-llm-stack/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Keep plenty of memory available for model loading.
MemoryMax=infinity
# Prevent OOM killer from killing the orchestrator first.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
