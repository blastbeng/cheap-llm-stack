[Unit]
Description=cheap-llm-stack llama-swap orchestrator (Orange Pi Zero 3W)
Documentation=https://github.com/mostlygeek/llama-swap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cheap-llm-stack
Environment=LLAMA_SWAP_CONFIG=/opt/cheap-llm-stack/config.yaml
ExecStart=/opt/cheap-llm-stack/bin/llama-swap --listen 0.0.0.0:10001 --config /opt/cheap-llm-stack/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=30

# Allow --mlock on the always-resident models (embedding + router).
LimitMEMLOCK=infinity
# Keep the proxy responsive while a model is generating.
Nice=-5
# Do not let the kernel OOM-kill the orchestrator before the heavy children.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
