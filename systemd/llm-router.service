[Unit]
Description=cheap-llm-stack llm-router (semantic orchestrator, OpenAI-compatible :10000)
Documentation=https://github.com/blastbeng/cheap-llm-stack
After=llama-swap.service network-online.target
Wants=llama-swap.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cheap-llm-stack
Environment=ROUTER_HOST=0.0.0.0
Environment=ROUTER_PORT=10000
Environment=LLAMA_SWAP_HOST=127.0.0.1
Environment=LLAMA_SWAP_PORT=10001
Environment=PYTHONUNBUFFERED=1
# Advertised window. Must match the `reasoner` --ctx-size in config.yaml: this is
# what /v1/models and /health report, and what agent clients budget against.
Environment=ROUTER_CONTEXT_LENGTH=16384
# Loop guard: after 10 tool results a turn answers with what it has. The schemas
# stay in the request — removing them (or tool_choice:"none", same thing) makes
# llama.cpp stop parsing and the model's `<tool_call>` markup leak into `content`
# as text, which is what killed the 08:09 automation run. 0 disables it.
Environment=ROUTER_TOOL_LOOP_MAX_RESULTS=10
# Turn a text `<tool_call>` block into a real `tool_calls` reply (streaming too).
# Safety net for a client that strips `tools` on its synthesis turn, or a template
# regression; 0 disables it.
Environment=ROUTER_REPAIR_TEXT_CALLS=1
# Quality tier escalation from `auto`: ON. A request that asks for reasoning and is
# longer than ROUTER_DEEP_MIN_CHARS (400) chars or ROUTER_DEEP_MIN_WORDS (25) words
# goes to Nemotron-3.5-Bolt for its whole session, including the turns that carry
# tool results; everything else stays on the MoE. The bar is judged on the last user
# turn only. 600/40 was measured too high: a real design question is ~30 words, so
# `auto` never left the MoE in 14 days of logs. The cost is explicit: 2.91 tok/s
# instead of 10.4 and ~100 s of reload the first time either model has to come back.
Environment=ROUTER_DEEP_TIER=1
Environment=ROUTER_DEEP_MIN_CHARS=400
Environment=ROUTER_DEEP_MIN_WORDS=25
# Mid-chat escalation: ON. A chat that started ordinary can move to the quality tier
# once, when a later user turn is the deep one. Never mid tool-loop (that model has
# to read its own result back) and never on an image turn (`bolt` is blind).
Environment=ROUTER_DEEP_ESCALATE=1
ExecStart=/usr/bin/python3 /opt/cheap-llm-stack/router/llm_router.py
Restart=always
RestartSec=3
Nice=-4
# The router is a Python proxy: keep it off the A76 cluster so generation
# never loses a core to a routing decision.
CPUAffinity=0-5
OOMScoreAdjust=-400

[Install]
WantedBy=multi-user.target
